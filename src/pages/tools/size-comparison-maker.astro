---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTool from '../../components/tool/ComparisonTool';
import '../../styles/tool.css';
import '../../styles/print.css';

const title = 'Size Comparison Maker — Draw Objects to True Scale';
const description =
  'Free classroom tool: compare any two or three objects at their real sizes. Pick from the object library or enter your own measurements, present full-screen to your class, and print A4/Letter worksheets. No sign-up.';
const path = '/tools/size-comparison-maker/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'SizeCompare — Size Comparison Maker',
  url: `https://sizecompare.org${path}`,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web browser',
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout title={title} description={description} path={path}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="section" style="padding-bottom: 24px">
    <div class="container">
      <h1>Size Comparison Maker</h1>
      <p class="lede">
        Put two or three objects side by side at their <strong>real, true scale</strong> —
        then present it to your class or print it as a worksheet. Every built-in
        measurement shows its source, so you can trust what's on the screen.
      </p>
    </div>
  </section>

  <div class="container" style="padding-bottom: 48px">
    <ComparisonTool client:visible />
  </div>

  <section class="section" style="background: var(--surface); border-top: 1px solid var(--line)">
    <div class="container">
      <div class="grid-3">
        <div class="card">
          <h3>1 · Choose objects</h3>
          <p>
            Pick from the classroom, everyday-object, and animal library — or add your
            own measurement in any unit (cm, m, mm, inches, feet, even
            <code>5'4"</code>-style input).
          </p>
        </div>
        <div class="card">
          <h3>2 · Compare to scale</h3>
          <p>
            Everything shares one scale factor and one ground line, so a 3.2 m elephant
            really towers over a 9 cm mouse. Objects are never stretched to fit.
          </p>
        </div>
        <div class="card">
          <h3>3 · Teach or print</h3>
          <p>
            Present full-screen with your classroom question and a reveal-answer button,
            download a PNG, or print a clean A4 / US Letter worksheet with a source table.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 780px">
      <h2>Why true scale matters</h2>
      <p>
        Most size pictures you find online are not drawn to scale — images get resized to
        fit the layout, which quietly teaches students the wrong proportions. This tool
        draws every object with the <em>same</em> pixels-per-millimetre, labels each
        object with its own measured dimension (height, length, width, or diameter), and
        shows where each number comes from.
      </p>
      <p>
        When two objects differ enormously (a mouse and a blue whale, say), the small one
        honestly becomes tiny. The canvas warns you instead of secretly enlarging it — a
        great discussion moment in itself.
      </p>
      <h2>Frequently asked questions</h2>
      <div class="faq">
        <details>
          <summary>Is it free? Do I need an account?</summary>
          <p>Free, no account, no uploads. Your comparison is saved in your own browser.</p>
        </details>
        <details>
          <summary>Can I use the pictures in my materials?</summary>
          <p>
            Yes — exported PNGs and printouts are yours to use in classroom materials. All
            silhouettes are original artwork (CC0). Measurement sources are listed under
            each object and on the printout.
          </p>
        </details>
        <details>
          <summary>Why only three objects at a time?</summary>
          <p>
            Three is plenty for K–8 size lessons and keeps labels readable. Ordering
            exercises with more objects are on the roadmap.
          </p>
        </details>
        <details>
          <summary>Where do the measurements come from?</summary>
          <p>
            Official standards where they exist (ISO 216 paper, ISO/IEC 7810 cards, NBA
            ball specs, ITF tennis balls) and reputable references for animals (National
            Geographic, university animal databases), each shown with its measurement
            context and check date. See the About page for the full source list.
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq details {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    margin-bottom: 10px;
    background: var(--surface);
  }
  .faq summary {
    font-weight: 600;
    cursor: pointer;
  }
  .faq p { margin-bottom: 0; margin-top: 8px; color: var(--ink-soft); }
  code {
    background: var(--surface-2);
    border-radius: 4px;
    padding: 1px 5px;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
