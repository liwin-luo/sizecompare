---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAIRS, pairSlug } from '../../data/pairs';
import { LIBRARY_BY_ID } from '../../data/library';
import { ATTRIBUTE_FAMILY, type AttributeKey } from '../../lib/attributes';

const title = 'Browse Comparisons — Animals, Space, Buildings & More';
const description =
  'Curated true-scale comparisons: elephant vs giraffe, Sun vs Earth, Burj Khalifa vs Eiffel Tower, car vs bicycle — heights, weights and volumes, all sourced.';
const path = '/compare/';

const groups: { label: string; attrs: AttributeKey[] }[] = [
  { label: 'Heights & lengths', attrs: ['height', 'length', 'width', 'diameter'] },
  { label: 'Weights', attrs: ['weight'] },
  { label: 'Volumes', attrs: ['volume'] },
];

const grouped = groups
  .map((g) => ({
    label: g.label,
    pairs: PAIRS.filter((p) => g.attrs.includes(p.attr)),
  }))
  .filter((g) => g.pairs.length > 0);
---

<BaseLayout title={title} description={description} path={path}>
  <section class="section" style="padding-bottom: 24px">
    <div class="container">
      <h1>Browse comparisons</h1>
      <p class="lede">
        Every page below is a real, sourced, true-scale comparison with an interactive
        chart — nothing generated, nothing stretched. Or skip the list and
        <a href="/studio/">make your own in the Studio</a>.
      </p>
    </div>
  </section>

  {
    grouped.map((group) => (
      <section class="section group" style="padding-block: 20px">
        <div class="container">
          <h2>{group.label}</h2>
          <ul class="pair-list">
            {group.pairs.map((p) => {
              const a = LIBRARY_BY_ID[p.a];
              const b = LIBRARY_BY_ID[p.b];
              const fam = ATTRIBUTE_FAMILY[p.attr];
              return (
                <li>
                  <a class="pair-card" href={`/compare/${pairSlug(p)}/`}>
                    <span class="pair-names">
                      {a.name} <span class="vs">vs</span> {b.name}
                    </span>
                    <span class={`badge badge-${fam}`}>{p.attr}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section" style="background: var(--surface); border-top: 1px solid var(--line)">
    <div class="container">
      <div class="grid-3">
        <div class="card">
          <h3>Can't find your pair?</h3>
          <p>
            The Studio has the full library plus custom objects — compare anything
            you can measure.
          </p>
          <p><a class="btn btn-primary" href="/studio/">Open the Studio</a></p>
        </div>
        <div class="card">
          <h3>Animal data table</h3>
          <p>Heights, lengths and weights of every animal in the library, with sources.</p>
          <p><a href="/animal-size-comparison/">See animal measurements →</a></p>
        </div>
        <div class="card">
          <h3>How the scale works</h3>
          <p>One scale factor, honest extremes, sourced numbers. See the method.</p>
          <p><a href="/about/">About our data →</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .group + .section { margin-top: 0; }
  .pair-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }
  .pair-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  .pair-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow);
    color: var(--primary-strong);
  }
  .vs { color: var(--ink-faint); font-weight: 400; font-style: italic; font-size: 0.9em; }
  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 999px;
    padding: 3px 9px;
    flex: none;
  }
  .badge-linear { background: #e3f0ee; color: #0a5850; }
  .badge-weight { background: #fdf1e3; color: #7c3f06; }
  .badge-volume { background: #ece8f8; color: #4c3591; }
</style>
