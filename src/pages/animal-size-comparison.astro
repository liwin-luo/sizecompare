---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTool from '../components/tool/ComparisonTool';
import { OBJECT_LIBRARY } from '../data/library';
import { ATTRIBUTE_LABELS, formatAttrValue } from '../lib/attributes';
import type { AttributeKey } from '../lib/attributes';
import '../styles/tool.css';
import '../styles/print.css';

const title = 'Animal Size Comparison — True-Scale Heights & Weights';
const description =
  'Compare real animal sizes and weights at true scale: elephant vs. mouse, giraffe vs. person, blue whale vs. all of them. Sourced measurements with ranges, printable for the classroom.';
const path = '/animal-size-comparison/';

const animals = OBJECT_LIBRARY.filter((r) => r.category === 'animal');
const columns: AttributeKey[] = ['height', 'length', 'weight'];
---

<BaseLayout title={title} description={description} path={path}>
  <section class="section">
    <div class="container">
      <h1>Animal size comparison</h1>
      <p class="lede">
        How tall is an elephant, really? How much does a blue whale weigh? The tool
        below starts with a classic — switch between height and weight, change the
        animals, then present or print. Every measurement is sourced, with ranges
        where nature varies.
      </p>
    </div>
  </section>

  <div class="container" style="padding-bottom: 40px">
    <ComparisonTool client:idle />
  </div>

  <section class="section strip">
    <div class="container">
      <h2>Animal measurements in this library</h2>
      <p class="muted small" style="margin-top: -10px">
        Representative adult values; ranges reflect natural variation. Measurement
        context (shoulder height, body length) is stated — never mix them silently.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Animal</th>
              {columns.map((c) => <th>{ATTRIBUTE_LABELS[c]}</th>)}
              <th>Sources</th>
            </tr>
          </thead>
          <tbody>
            {
              animals.map((a) => {
                const sources = [
                  ...new Set(
                    columns
                      .map((c) => a.measurements[c]?.source_name)
                      .filter((s): s is string => Boolean(s)),
                  ),
                ];
                const firstUrl = a.measurements[columns.find((c) => a.measurements[c])!]
                  ?.source_url ?? '#';
                return (
                  <tr>
                    <td>{a.name}</td>
                    {columns.map((c) => {
                      const m = a.measurements[c];
                      return (
                        <td>
                          {m ? (
                            <span>
                              {formatAttrValue(c, m.value, 'metric')}
                              {m.min != null && m.max != null && (
                                <span class="range">
                                  {' '}
                                  ({formatAttrValue(c, m.min, 'metric')} – {formatAttrValue(c, m.max, 'metric')})
                                </span>
                              )}
                            </span>
                          ) : (
                            '—'
                          )}
                        </td>
                      );
                    })}
                    <td>
                      <a href={firstUrl} rel="nofollow noopener" target="_blank">
                        {sources.join(' · ')}
                      </a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p class="muted small">
        Dinosaur comparisons are on the roadmap — prehistoric sizes are fossil
        estimates, so they need their own careful presentation with estimate ranges.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .strip {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .table-wrap {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92rem;
    min-width: 640px;
  }
  th,
  td {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  th {
    background: var(--surface-2);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  tr:last-child td { border-bottom: none; }
  .range { color: var(--ink-faint); font-size: 0.85em; white-space: nowrap; }
</style>
