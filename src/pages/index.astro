---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import CompareStudio from '../components/tool/ComparisonTool';
import { PAIRS, pairSlug } from '../data/pairs';
import { LIBRARY_BY_ID, OBJECT_LIBRARY } from '../data/library';
import '../styles/tool.css';
import '../styles/print.css';

const faqs = [
  {
    q: 'What does "true scale" mean here?',
    a: 'Every object in a comparison is drawn with the same scale factor — a 3.2 m elephant really towers over a 26 m whale by exactly the same ratio as in real life. Images are never resized or stretched to fit the layout.',
  },
  {
    q: 'Is SizeCompare free? Do I need an account?',
    a: 'It is free and needs no account. Comparisons are created in your browser and saved on your own device — nothing is uploaded.',
  },
  {
    q: 'Where do the measurements come from?',
    a: 'Official standards where they exist (ISO paper and card sizes, NASA planetary fact sheets, NBA ball specs) and reputable references for animals, buildings and vehicles. Every object shows its source, measurement context, and uncertainty range.',
  },
  {
    q: 'Why does the small object look SO small sometimes?',
    a: 'Because it really is that small. A house mouse is about 1/40th of an elephant\'s height and 1/300,000th of its weight — honest scale looks extreme, and we show a warning instead of secretly enlarging anything.',
  },
];

const popular = PAIRS.slice(0, 6);
const counts = OBJECT_LIBRARY.reduce<Record<string, number>>((acc, r) => {
  acc[r.category] = (acc[r.category] ?? 0) + 1;
  return acc;
}, {});
const categories = [
  { label: 'Animals', count: counts.animal ?? 0, blurb: 'Elephants, whales, T. rex, penguins — heights, lengths and weights.' },
  { label: 'Space', count: counts.space ?? 0, blurb: 'Sun, Earth, Moon, Jupiter, Mars — diameters and volumes from NASA.' },
  { label: 'Buildings', count: counts.building ?? 0, blurb: 'Eiffel Tower, Burj Khalifa, Statue of Liberty, Everest.' },
  { label: 'Vehicles', count: counts.vehicle ?? 0, blurb: 'Bikes, cars, pickups, school buses — lengths and weights.' },
  { label: 'Everyday', count: counts.everyday ?? 0, blurb: 'Phones, TVs, balls, beds, tools — things you can hold.' },
  { label: 'Food', count: counts.food ?? 0, blurb: 'Bananas, eggs, watermelons — measure your lunch.' },
];
---

<BaseLayout title={SITE.name} description={SITE.description} path="/" bareTitle>
  <script type="application/ld+json" set:html={JSON.stringify([{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.origin, description: SITE.description }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }])} />

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1>Compare anything — height, weight, volume</h1>
      <p class="lede">
        Search {LIBRARY_BY_ID ? Object.keys(LIBRARY_BY_ID).length : 50}+ measured objects, compare
        them at their <strong>true scale</strong>, and see where every number comes from.
        Free, no sign-up.
      </p>
      <p class="hero-actions">
        <a class="btn btn-primary btn-lg" href="#studio">Start comparing ↓</a>
        <a class="btn btn-ghost btn-lg" href="/compare/">Browse curated comparisons</a>
      </p>
    </div>
  </section>

  <!-- Studio -->
  <div id="studio" class="container studio-home">
    <CompareStudio client:idle />
  </div>

  <!-- Popular pairs -->
  <section class="section strip">
    <div class="container">
      <h2>Popular comparisons</h2>
      <ul class="pair-grid">
        {
          popular.map((p) => (
            <li>
              <a class="pair-card" href={`/compare/${pairSlug(p)}/`}>
                {LIBRARY_BY_ID[p.a].name} <span class="vs">vs</span> {LIBRARY_BY_ID[p.b].name}
              </a>
            </li>
          ))
        }
      </ul>
      <p><a href="/compare/">See all curated comparisons →</a></p>
    </div>
  </section>

  <!-- Categories -->
  <section class="section">
    <div class="container">
      <h2>Browse by category</h2>
      <div class="grid-3">
        {
          categories.map((c) => (
            <a class="card link-card" href="/compare/">
              <h3>{c.label} <span class="count">{c.count}</span></h3>
              <p>{c.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section strip">
    <div class="container narrow">
      <h2>How the scale works</h2>
      <div class="grid-3">
        <div>
          <h3>Heights & lengths</h3>
          <p>One shared scale factor and ground line. Objects that measure different dimensions are flagged, never mixed silently.</p>
        </div>
        <div>
          <h3>Weights</h3>
          <p>Bars exactly proportional to real mass — no truncated axes, no log scales.</p>
        </div>
        <div>
          <h3>Volumes</h3>
          <p>Spheres scale by the cube root of volume, with the rule printed on the canvas — because 3-D honesty needs a caption.</p>
        </div>
      </div>
      <p>
        When the difference is enormous, the small object honestly stays tiny — and we say so.
        That honesty is the whole point.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow">
      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: 64px 40px; text-align: center; }
  .hero h1 { max-width: 24ch; margin-inline: auto; }
  .hero .lede { margin-inline: auto; max-width: 56ch; }
  .hero-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 26px; }
  .studio-home { padding-bottom: 24px; }
  .strip { background: var(--surface); border-block: 1px solid var(--line); }
  .narrow { max-width: 860px; }
  .pair-grid {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }
  .pair-card {
    display: block;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  .pair-card:hover { border-color: var(--primary); color: var(--primary-strong); box-shadow: var(--shadow); }
  .vs { color: var(--ink-faint); font-weight: 400; font-style: italic; font-size: 0.9em; }
  .link-card { text-decoration: none; color: inherit; }
  .link-card h3 { color: var(--primary); }
  .count {
    font-size: 0.72rem;
    background: var(--primary-soft);
    color: var(--primary-strong);
    border-radius: 999px;
    padding: 2px 8px;
    vertical-align: middle;
  }
  details {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    margin-bottom: 10px;
    background: var(--surface);
  }
  summary { font-weight: 600; cursor: pointer; }
  details p { margin: 8px 0 0; color: var(--ink-soft); }
</style>
