---
const links = [
  { href: '/studio/', label: 'Studio' },
  { href: '/compare/', label: 'Compare' },
  { href: '/animal-size-comparison/', label: 'Animals' },
  { href: '/about/', label: 'About' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="SizeCompare home">
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
        <rect x="3" y="12" width="8" height="13" rx="1.5" fill="var(--obj-1)" />
        <rect x="15" y="4" width="8" height="21" rx="1.5" fill="var(--obj-4)" />
        <line x1="1" y1="26.5" x2="27" y2="26.5" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <span class="brand-name">SizeCompare</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={currentPath === l.href ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 10px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 800;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }
  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    display: inline-block;
    padding: 7px 12px;
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--primary);
    background: var(--primary-soft);
  }
  nav a[aria-current='page'] {
    color: var(--primary);
    background: var(--primary-soft);
  }
</style>
