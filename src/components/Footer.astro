---
import { SITE } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div>
        <p class="brand">{SITE.name}</p>
        <p class="small muted">{SITE.tagline}.</p>
      </div>
      <nav aria-label="Footer">
        <ul>
          <li><a href="/tools/size-comparison-maker/">Size Comparison Maker</a></li>
          <li><a href="/size-comparison-for-kids/">For Teachers</a></li>
          <li><a href="/animal-size-comparison/">Animal Size Comparison</a></li>
          <li><a href="/guides/how-to-teach-big-and-small/">Teaching Guide</a></li>
          <li><a href="/about/">About &amp; Data Sources</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </nav>
    </div>
    <p class="small muted legal">
      &copy; {year} {SITE.name}. Everything you create stays in your browser — no
      account, no uploads. Size figures are representative values; see each
      object's measurement notes for sources and ranges.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
    margin-top: 64px;
    padding-block: 36px 28px;
  }
  .cols {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .brand {
    font-weight: 800;
    margin: 0;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 40px;
  }
  nav li { margin-bottom: 6px; }
  nav a { font-size: 0.925rem; }
  .legal { max-width: 72ch; margin-bottom: 0; }
</style>
